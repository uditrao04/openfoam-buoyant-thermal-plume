FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p_rgh
    {
        solver          GAMG;
        tolerance       1e-8;
        relTol          0.01;

        smoother        DICGaussSeidel;

        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    "(U|T|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;

    pRefCell       0;
    pRefValue      0;

    residualControl
    {
        p_rgh          1e-4;
        U              1e-6;
        T              1e-6;
        "(k|omega)"    1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p_rgh 0.3;
    }

    equations
    {
        U       0.5;
        T       0.5;
        k       0.5;
        omega   0.5;
    }
}
